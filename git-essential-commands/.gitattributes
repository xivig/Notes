# Set default behavior: auto-normalize text files to LF on commit
* text=auto eol=lf

# Explicit text files
*.sh text eol=lf
*.bash text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
