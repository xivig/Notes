# -*- mode: ruby -*-
# vi: set ft=ruby :

# Modern Ubuntu 22.04 LTS (Jammy Jellyfish) + Docker Engine Development Environment
Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = true
  config.vm.hostname = "docker-dev.local"

  # Port Forwarding: Host 8080 -> Guest 80
  config.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"

  # Port Forwarding: Host 3000 -> Guest 3000 (Common dev server port)
  config.vm.network "forwarded_port", guest: 3000, host: 3000, host_ip: "127.0.0.1"

  # Optional Private Network
  # config.vm.network "private_network", ip: "192.168.56.20"

  # Synced Folders
  config.vm.synced_folder ".", "/vagrant", disabled: false

  # VirtualBox Hypervisor Resources
  config.vm.provider "virtualbox" do |vb|
    vb.name = "ubuntu-jammy-docker-dev"
    vb.memory = 2048
    vb.cpus = 2
    vb.linked_clone = true
  end

  # Automated Docker CE & Docker Compose Provisioning
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    export DEBIAN_FRONTEND=noninteractive

    echo "==> Updating package cache..."
    apt-get update -y
    apt-get install -y ca-certificates curl gnupg lsb-release

    echo "==> Installing official Docker Engine..."
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg

    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

    apt-get update -y
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

    # Enable non-root docker access for vagrant user
    usermod -aG docker vagrant
    systemctl enable docker
    systemctl start docker

    echo "==> Docker installed successfully!"
    docker --version
    docker compose version
  SHELL
end
